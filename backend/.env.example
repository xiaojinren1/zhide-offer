# 本机运行配置。这些是「平台默认端点」，只影响 /api/health 的 llm_configured、脚本与测试；
# 页面里的文本任务和图片解析使用每个账户在「模型中心」自己启用的模型，缺配置时返回 428 并引导去配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai-next.com/v1
MODEL=
JOBAGENT_HOST=127.0.0.1
JOBAGENT_PORT=8000

# 仅首次迁移用：逗号分隔的已注册用户名会被提升为管理员，确认「管理后台」出现后可删除。
JOBAGENT_ADMIN_USERNAMES=

# 可选：允许用户填写的可信公网 HTTPS Base URL，逗号分隔。
JOBAGENT_CUSTOM_MODEL_BASE_URLS=

# 个人模型凭据加密密钥，填入独立生成的 32 字节随机值的 urlsafe Base64；换新密钥会让已保存的个人模型配置无法解密。
# 生成：.\.venv\Scripts\python.exe -c "import base64,secrets; print('JOBAGENT_MODEL_ENCRYPTION_KEY=' + base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
JOBAGENT_MODEL_ENCRYPTION_KEY=

# 可选：导出 PDF 使用的中文 TrueType 字体绝对路径。
JOBAGENT_PDF_FONT=
