# 应用运行配置，开发Codex模型与这里独立。
# 从服务商指南复制实际 API 地址与模型 ID，勿填写网页指南地址。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai-next.com/v1
MODEL=
JOBAGENT_HOST=127.0.0.1
JOBAGENT_PORT=8000

# Optional comma-separated existing usernames with access to aggregate user stats.
JOBAGENT_ADMIN_USERNAMES=

# Optional comma-separated trusted public HTTPS Base URLs for OpenAI-compatible models.
JOBAGENT_CUSTOM_MODEL_BASE_URLS=

# 个人模型凭据加密密钥，填入独立生成的 32 字节随机值的 Base64 编码
JOBAGENT_MODEL_ENCRYPTION_KEY=
