# 服务器私有配置模版，不提交真实密钥。
# 用法二选一：
#   1) 默认：复制为 /opt/jobagent/backend/.env（不设 JOBAGENT_ENV_FILE 时后端就读它）
#   2) 加固：复制到 /etc/jobagent/jobagent.env，并在 systemd 单元里设 JOBAGENT_ENV_FILE 指向它
# 设了 JOBAGENT_ENV_FILE 后不会再读 backend/.env，文件缺失或不可读会直接启动失败。
# 平台默认端点：只影响 /api/health 的 llm_configured、脚本与测试；
# 页面业务请求使用每个账户在「模型中心」自己启用的模型，缺配置时返回 428，不用这里的 key 兜底。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai-next.com/v1
MODEL=deepseek-v4-flash
JOBAGENT_HOST=127.0.0.1
JOBAGENT_PORT=8000
# 加密保存个人模型 API Key 的独立密钥（32 字节随机值的 urlsafe base64）。缺失时用户无法保存个人模型。
# 生成：.venv/bin/python -c "import base64,secrets; print('JOBAGENT_MODEL_ENCRYPTION_KEY=' + base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
JOBAGENT_MODEL_ENCRYPTION_KEY=
# 自定义 Base URL 白名单，逗号分隔。默认不拦截公网 HTTPS 端点；
# 只有把 _STRICT 设为 1 时才要求命中白名单（内网/自建网关场景）。
JOBAGENT_CUSTOM_MODEL_BASE_URLS=
JOBAGENT_CUSTOM_MODEL_BASE_URLS_STRICT=
# 首次迁移用：已注册用户名提升为管理员，确认「管理后台」出现后可删除该行。
JOBAGENT_ADMIN_USERNAMES=
# 填写服务器实际存在且服务账户可读的中文 TrueType 字体路径。
JOBAGENT_PDF_FONT=
